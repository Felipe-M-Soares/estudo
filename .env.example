# Copie este arquivo para .env no servidor/deploy e altere todos os segredos.

# Supabase: guarda TODOS os dados do app (usuarios, licencas, pedidos,
# progresso e eventos). Crie um projeto em https://supabase.com, rode o
# arquivo supabase/schema.sql no SQL Editor do projeto, depois copie estes
# dois valores em Project Settings > API:
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A "service_role key" (NAO a "anon public key"). Ela e secreta: da acesso
# total ao banco e so pode existir aqui no servidor, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

PORT=8787
HOST=0.0.0.0
# So guarda os segredos locais (secrets.json), NAO os dados do app - esses
# agora ficam no Supabase.
DATA_DIR=./.data
PUBLIC_APP_URL=https://seudominio.com

# Opcional: se voce NAO definir TOKEN_SECRET/ADMIN_TOKEN, o servidor gera
# valores aleatorios sozinho na primeira vez e salva em .data/secrets.json.
# Isso ja e seguro para comecar, mas em producao e mais robusto definir aqui
# valores longos e unicos que voce mesmo controla.
TOKEN_SECRET=troque-por-um-segredo-longo-com-mais-de-32-caracteres
ADMIN_TOKEN=troque-por-um-token-admin-longo

# Opcional: exige esse token no cadastro para o PRIMEIRO usuario (o "dono"
# da plataforma) receber o papel de owner. Deixe em branco em uso pessoal/
# local; defina em producao para evitar que qualquer pessoa vire owner caso
# o banco seja resetado.
OWNER_SETUP_TOKEN=

# true = aluno precisa ativar uma licenca para sincronizar progresso.
REQUIRE_LICENSE=true

# false em producao para nao criar a licenca publica de teste DEVQUEST-DEMO-2026.
SEED_DEMO_LICENSE=false

# Separe por virgula quando o frontend estiver em outro dominio.
ALLOWED_ORIGINS=https://seudominio.com

# Mercado Pago: necessario para checkout real por plano.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=troque-por-um-segredo-de-webhook

# Stripe: checkout internacional (cartao em qualquer pais, cobrado em USD).
# Pegue em https://dashboard.stripe.com/apikeys (chave "secret key").
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
# Pegue em https://dashboard.stripe.com/webhooks apos criar o endpoint
# https://seudominio.com/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Opcional: tempo de sessao em segundos.
TOKEN_TTL_SECONDS=604800
