# Copie este arquivo para .env no servidor/deploy e altere todos os segredos.

PORT=8787
HOST=0.0.0.0
DATA_DIR=./.data

# Obrigatorio em producao: gere valores longos e unicos.
TOKEN_SECRET=troque-por-um-segredo-longo-com-mais-de-32-caracteres
ADMIN_TOKEN=troque-por-um-token-admin-longo

# true = aluno precisa ativar uma licenca para sincronizar progresso.
REQUIRE_LICENSE=true

# false em producao para nao criar a licenca publica de teste DEVQUEST-DEMO-2026.
SEED_DEMO_LICENSE=false

# Separe por virgula quando o frontend estiver em outro dominio.
ALLOWED_ORIGINS=https://seudominio.com

# Opcional: tempo de sessao em segundos.
TOKEN_TTL_SECONDS=604800
