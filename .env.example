# ============================================================================
# Code Mage — variáveis de ambiente
# Copie este arquivo para ".env" (local) e cadastre as mesmas chaves no painel
# do Vercel (Project Settings > Environment Variables) para produção.
# Veja o passo a passo completo em SETUP.md
# ============================================================================

# --- Supabase (auth + banco de dados) ---------------------------------------
# Painel do Supabase > Project Settings > API
# Estas duas são PÚBLICAS (prefixo VITE_ = vão para o navegador). Tudo bem,
# a proteção real é a Row Level Security (RLS) configurada em supabase/schema.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Supabase (só para as funções serverless em /api, NUNCA no navegador) ---
# Painel do Supabase > Project Settings > API > service_role (secret)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-SECRETA

# --- Mercado Pago (só para /api, NUNCA no navegador) -------------------------
# Painel do Mercado Pago > Seu negócio > Configurações > Credenciais de produção
# (use as credenciais de TESTE enquanto estiver validando o fluxo)
MP_ACCESS_TOKEN=seu-access-token-secreto
# Opcional, mas recomendado: painel Mercado Pago > Webhooks > Chave secreta de assinatura
MP_WEBHOOK_SECRET=sua-chave-secreta-de-webhook

# --- URL pública do site (usada nos links de retorno do checkout) ----------
# Em produção: a URL do seu domínio no Vercel, ex: https://codemage.vercel.app
PUBLIC_SITE_URL=http://localhost:5173
